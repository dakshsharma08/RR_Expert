# ─────────────────────────────────────────────────────────────
# LOCKSTEP environment variables. Copy to `.env` and fill in.
# NEVER prefix secrets with VITE_ — anything with VITE_ is shipped
# to the browser. The build fails if GEMINI_API_KEY leaks into dist/.
# ─────────────────────────────────────────────────────────────

# Required for all AI features (server-side only).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Leave empty to auto-pick the newest stable Flash model your key can use.
GEMINI_MODEL=
# Optional. A Pro model used for replanning (falls back to GEMINI_MODEL if it fails).
GEMINI_MODEL_HEAVY=

# Optional: durable rate limiting on serverless (Upstash Redis REST).
# Without these, rate limiting is in-memory (fine locally, weak on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Supabase (cloud sync, auth, ai_runs logging, Living Wallpaper storage).
# The anon key is public by design (protected by Row Level Security).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed browser origins for the API (CORS).
# Example: https://lockstep.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8787

# Number of reverse-proxy hops to trust for client IPs (rate limiting).
# 0 = trust none (safe default; `npm start` on a bare server). Cloud Run: 1. Vercel is detected automatically.
TRUST_PROXY=0

# Optional: pin an image-capable model for AI backgrounds (else auto-discovered, or hidden).
GEMINI_IMAGE_MODEL=

# Public base URL of the deployed app (used in Living Wallpaper links + cover image).
PUBLIC_APP_URL=
