{
  "name": "lockstep",
  "private": true,
  "version": "1.0.0",
  "description": "LOCKSTEP — Gemini-planned countdown lock screen. Turns a deadline into a milestone plan, a live countdown and a lock-screen wallpaper.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan \"vite\" \"tsx watch server/dev.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "tsc -b && vite build && node scripts/build-server.mjs && node scripts/check-bundle-secrets.mjs",
    "start": "NODE_ENV=production tsx server/prod.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live",
    "test:e2e": "playwright test --trace off",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "submission": "node scripts/submission.mjs",
    "build:server": "node scripts/build-server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@google/genai": "3.6.1",
    "@hookform/resolvers": "7.0.8",
    "@napi-rs/canvas": "1.2.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "5.108.3",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "express": "5.3.0",
    "framer-motion": "14.14.0",
    "helmet": "8.3.0",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "7.18.6",
    "recharts": "3.11.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-window": "7.4.1"
  }
}
